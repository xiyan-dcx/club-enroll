{
  "info": {
    "name": "青聚：并发与缓存对照",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 缓存对照（只运行此文件夹）",
      "item": [
        {
          "name": "活动列表",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{studentCookie}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/activities"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 and business success',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().code).to.eql(0)});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 名额竞争（附 users.json）",
      "item": [
        {
          "name": "预约同一场次",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/reserve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activityId\": {{activityId}},\n  \"studentNo\": \"{{studentNo}}\",\n  \"realName\": \"{{realName}}\",\n  \"requestId\": \"{{bookingKey}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('bookingKey','visit-'+pm.environment.get('activityId')+'-'+pm.iterationData.get('studentNo'));",
                  "const cookie=pm.iterationData.get('sessionCookie');if(!cookie)throw Error('Attach users.json as performance data file');pm.request.headers.upsert({key:'Cookie',value:cookie});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No unexpected server/auth error',()=>pm.expect([200,400,429]).to.include(pm.response.code)); if(pm.response.code===200)pm.test('Confirmed',()=>pm.expect(pm.response.json().data.status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 手动检查（不要参与压力循环）",
      "item": [
        {
          "name": "A 记录压测前计数",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{adminCookie}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/cache-metrics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 and business success',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().code).to.eql(0)});const m=pm.response.json().data;pm.environment.set('cacheBefore',JSON.stringify(m));"
                ]
              }
            }
          ]
        },
        {
          "name": "B 查看本轮回源统计",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{adminCookie}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/cache-metrics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 and business success',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().code).to.eql(0)});const m=pm.response.json().data;const before=JSON.parse(pm.environment.get('cacheBefore')||'{}');if(before.enabled!==m.enabled)throw Error('Record start snapshot after restarting');const requests=m.requests-before.requests,loads=m.databaseLoads-before.databaseLoads;const result={mode:m.enabled?'开启缓存':'关闭缓存',requests,databaseLoads:loads,loadPercent:requests?(loads/requests*100).toFixed(2):'0'};console.log(result);pm.visualizer.set('<style>body{font:18px sans-serif}td,th{padding:16px;border:1px solid #ddd}</style><h2>{{mode}}</h2><table><tr><th>缓存入口请求</th><th>数据库回源</th><th>回源比例</th></tr><tr><td>{{requests}}</td><td>{{databaseLoads}}</td><td>{{loadPercent}}%</td></tr></table>',result);"
                ]
              }
            }
          ]
        },
        {
          "name": "C 检查预约人数及学号唯一性",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{adminCookie}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/roster?activityId={{activityId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 and business success',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().code).to.eql(0)});const rows=pm.response.json().data.filter(x=>x.status==='CONFIRMED');pm.test('Exactly 10 confirmed',()=>pm.expect(rows.length).to.eql(10));pm.test('Unique student numbers',()=>pm.expect(new Set(rows.map(x=>x.student_no)).size).to.eql(rows.length));pm.visualizer.set('<h2>有效预约：{{count}} / 10</h2><table>{{#each rows}}<tr><td>{{student_no}}</td><td>{{real_name}}</td><td>{{status}}</td></tr>{{/each}}</table>',{count:rows.length,rows});"
                ]
              }
            }
          ]
        },
        {
          "name": "D 查看 Outbox 与预占状态",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{adminCookie}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/operations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 and business success',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().code).to.eql(0)});"
                ]
              }
            }
          ]
        },
        {
          "name": "E 新建下一轮竞争场次",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{adminCookie}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/publish",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clubId\": {{benchmarkClubId}},\n  \"title\": \"Postman名额竞争\",\n  \"content\": \"场馆参观\",\n  \"location\": \"Hall\",\n  \"capacity\": 10,\n  \"opensAt\": \"{{opensAt}}\",\n  \"closesAt\": \"{{closesAt}}\",\n  \"cancelUntil\": \"{{cancelUntil}}\",\n  \"startsAt\": \"{{startsAt}}\",\n  \"endsAt\": \"{{endsAt}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for(const [key,h] of Object.entries({opensAt:-1,closesAt:24,cancelUntil:25,startsAt:26,endsAt:27}))pm.variables.set(key,new Date(Date.now()+(h+8)*3600000).toISOString().slice(0,19));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 and business success',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().code).to.eql(0)});pm.environment.set('activityId',String(pm.response.json().data.id));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 单次40并发（无数据文件）",
      "item": [
        {
          "name": "发送一批并发预约",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{adminCookie}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 and business success',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().code).to.eql(0)});",
                  "const users=JSON.parse(pm.environment.get('usersJson')||'[]');",
                  "pm.test('40 independent users supplied',()=>pm.expect(users.length).to.eql(40));",
                  "if(users.length!==40)throw Error('Refresh and import generated environment');",
                  "const url=pm.environment.get('baseUrl'),id=Number(pm.environment.get('activityId'));",
                  "Promise.all(users.map(u=>new Promise(resolve=>{",
                  " const start=Date.now();pm.sendRequest({url:url+'/portal/reserve',method:'POST',header:{'Content-Type':'application/json',Cookie:u.sessionCookie},body:{mode:'raw',raw:JSON.stringify({activityId:id,studentNo:u.studentNo,realName:u.realName,requestId:'visit-'+id+'-'+u.studentNo})}},(err,res)=>resolve({studentNo:u.studentNo,status:err?0:res.code,ms:Date.now()-start,message:err?String(err):res.json().message}));",
                  "}))).then(rows=>{",
                  " const times=rows.map(x=>x.ms).sort((a,b)=>a-b),success=rows.filter(x=>x.status===200).length;",
                  " pm.test('Exactly 10 successful first submissions',()=>pm.expect(success).to.eql(10));",
                  " pm.test('Remaining requests are business rejections',()=>pm.expect(rows.filter(x=>x.status===400).length).to.eql(30));",
                  " const report={success,total:rows.length,p95:times[Math.ceil(times.length*.95)-1],rows};console.log(report);",
                  " pm.visualizer.set('<h2>单批并发：{{total}}，成功：{{success}}</h2><p>客户端单批 P95：{{p95}} ms（非持续压测）</p><table>{{#each rows}}<tr><td>{{studentNo}}</td><td>{{status}}</td><td>{{ms}} ms</td><td>{{message}}</td></tr>{{/each}}</table>',report);",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}